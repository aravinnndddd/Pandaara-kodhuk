<Window x:Class="DigitalMosquito.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Digital Mosquito"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="True"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Canvas x:Name="OverlayCanvas" Background="Transparent">

        <!-- Blood splatter layer -->
        <Canvas x:Name="BloodCanvas" IsHitTestVisible="False" />

        <!-- Mosquito layer -->
        <Canvas x:Name="MosquitoContainer" IsHitTestVisible="False" />

        <!-- Swat Impact Ripple FX -->
        <Ellipse x:Name="ImpactRipple"
                 Width="0" Height="0"
                 Stroke="#88FF2222"
                 StrokeThickness="3"
                 Opacity="0"
                 IsHitTestVisible="False" />

        <!-- Cleaning Prompt & Progress Indicator -->
        <Border x:Name="CleaningPrompt"
                CornerRadius="16"
                Background="#D018181E"
                BorderBrush="#44FF4444"
                BorderThickness="1"
                Padding="12,6"
                Opacity="0"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🧽" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Rub mouse to clean blood!"
                               Foreground="#EEEEEE"
                               FontSize="12"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI, sans-serif" />
                    <ProgressBar x:Name="CleaningProgressBar"
                                 Width="130" Height="4"
                                 Margin="0,3,0,0"
                                 Background="#33FFFFFF"
                                 Foreground="#FF4444"
                                 Minimum="0" Maximum="100" Value="0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Cleaned Sparkle FX -->
        <TextBlock x:Name="SparkleFx"
                   Text="✨ Cleaned!"
                   Foreground="#FFDF00"
                   FontWeight="Bold"
                   FontSize="16"
                   Opacity="0"
                   IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFD700" Opacity="0.8" />
            </TextBlock.Effect>
        </TextBlock>

        <!-- Top-Right Discreet Kill Badge HUD -->
        <Border x:Name="HudBadge"
                Canvas.Right="24" Canvas.Top="20"
                CornerRadius="14"
                Background="#B0141418"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                Padding="12,6"
                Opacity="0.85"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🦟" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="KillCountText"
                           Text="0 Kills"
                           Foreground="#FFFFFF"
                           FontWeight="Bold"
                           FontSize="12"
                           FontFamily="Segoe UI, sans-serif"
                           VerticalAlignment="Center" />
                <TextBlock Text=" • Esc to exit"
                           Foreground="#888888"
                           FontSize="11"
                           FontFamily="Segoe UI, sans-serif"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

    </Canvas>
</Window>