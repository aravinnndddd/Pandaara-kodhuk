<Window x:Class="DigitalMosquito.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Digital Mosquito"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="True"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Canvas x:Name="OverlayCanvas" Background="Transparent">

        <!-- Blood splatter layer -->
        <Canvas x:Name="BloodCanvas" IsHitTestVisible="False" />

        <!-- Mosquito layer -->
        <Canvas x:Name="MosquitoContainer" IsHitTestVisible="False" />

        <!-- Swat Impact Ripple FX -->
        <Ellipse x:Name="ImpactRipple"
                 Width="0" Height="0"
                 Stroke="#88FF2222"
                 StrokeThickness="3"
                 Opacity="0"
                 IsHitTestVisible="False" />

        <!-- Cleaning Prompt & Progress Indicator -->
        <Border x:Name="CleaningPrompt"
                CornerRadius="16"
                Background="#D018181E"
                BorderBrush="#44FF4444"
                BorderThickness="1"
                Padding="12,6"
                Opacity="0"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🧽" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Rub mouse to clean blood!"
                               Foreground="#EEEEEE"
                               FontSize="12"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI, sans-serif" />
                    <ProgressBar x:Name="CleaningProgressBar"
                                 Width="130" Height="4"
                                 Margin="0,3,0,0"
                                 Background="#33FFFFFF"
                                 Foreground="#FF4444"
                                 Minimum="0" Maximum="100" Value="0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Cleaned Sparkle FX -->
        <TextBlock x:Name="SparkleFx"
                   Text="✨ Cleaned!"
                   Foreground="#FFDF00"
                   FontWeight="Bold"
                   FontSize="16"
                   Opacity="0"
                   IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFD700" Opacity="0.8" />
            </TextBlock.Effect>
        </TextBlock>

        <!-- Top-Right Discreet HUD: Kill Counter, Speed Controls, & Exit -->
        <Border x:Name="HudBadge"
                Canvas.Right="24" Canvas.Top="20"
                CornerRadius="14"
                Background="#D8141418"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
                Padding="12,6"
                Opacity="0.95"
                IsHitTestVisible="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.45" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Kill Counter -->
                <TextBlock Text="🦟" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="KillCountText"
                           Text="0 Kills"
                           Foreground="#FFFFFF"
                           FontWeight="Bold"
                           FontSize="12"
                           FontFamily="Segoe UI, sans-serif"
                           VerticalAlignment="Center" />

                <!-- Separator -->
                <Rectangle Width="1" Height="14" Fill="#33FFFFFF" Margin="10,0" VerticalAlignment="Center" />

                <!-- Speed Control Label -->
                <TextBlock Text="Speed:"
                           Foreground="#888888"
                           FontSize="11"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI, sans-serif"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />

                <!-- Speed Presets -->
                <Border x:Name="SpeedBtnSlow"
                        CornerRadius="6"
                        Background="#20FFFFFF"
                        Padding="6,2"
                        Margin="0,0,3,0"
                        Cursor="Hand"
                        MouseDown="SpeedBtn_MouseDown"
                        Tag="0.5">
                    <TextBlock x:Name="SpeedTxtSlow" Text="0.5x" FontSize="11" FontWeight="SemiBold" Foreground="#888888" />
                </Border>

                <Border x:Name="SpeedBtnNormal"
                        CornerRadius="6"
                        Background="#CCFF2222"
                        Padding="6,2"
                        Margin="0,0,3,0"
                        Cursor="Hand"
                        MouseDown="SpeedBtn_MouseDown"
                        Tag="1.0">
                    <TextBlock x:Name="SpeedTxtNormal" Text="1.0x" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                </Border>

                <Border x:Name="SpeedBtnFast"
                        CornerRadius="6"
                        Background="#20FFFFFF"
                        Padding="6,2"
                        Margin="0,0,3,0"
                        Cursor="Hand"
                        MouseDown="SpeedBtn_MouseDown"
                        Tag="1.8">
                    <TextBlock x:Name="SpeedTxtFast" Text="1.8x" FontSize="11" FontWeight="SemiBold" Foreground="#888888" />
                </Border>

                <Border x:Name="SpeedBtnChaos"
                        CornerRadius="6"
                        Background="#20FFFFFF"
                        Padding="6,2"
                        Cursor="Hand"
                        MouseDown="SpeedBtn_MouseDown"
                        Tag="2.8">
                    <TextBlock x:Name="SpeedTxtChaos" Text="⚡ 2.8x" FontSize="11" FontWeight="SemiBold" Foreground="#888888" />
                </Border>

                <!-- Separator -->
                <Rectangle Width="1" Height="14" Fill="#33FFFFFF" Margin="10,0" VerticalAlignment="Center" />

                <!-- Exit Button -->
                <Border x:Name="ExitBtn"
                        CornerRadius="6"
                        Background="#20FFFFFF"
                        Padding="6,2"
                        Cursor="Hand"
                        MouseDown="ExitBtn_MouseDown">
                    <TextBlock Text="✕ Exit"
                               Foreground="#FF6666"
                               FontSize="11"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI, sans-serif"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>

    </Canvas>
</Window>