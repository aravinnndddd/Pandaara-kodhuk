<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PandaaraKodhuk</AssemblyName>
    <AssemblyTitle>Pandaara കൊതുക്</AssemblyTitle>
    <Product>Pandaara കൊതുക്</Product>
    <Description>Pandaara കൊതുക് - Desktop Mosquito and Creature Overlay Game</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Update="mosquito-sound.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Sounds\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
